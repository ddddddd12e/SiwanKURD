# نام برند تو؛ توی همه‌ی صفحه‌ها و ربات نمایش داده می‌شه
BRAND_NAME=SiwanKURD
ADMIN_USER=admin
ADMIN_PASS=یه-رمز-قوی-بذار
SECRET_KEY=یه-رشته-تصادفی-طولانی
# اختیاری: توکن ربات از @BotFather
TELEGRAM_BOT_TOKEN=
# اگه ۱ باشه هر کسی /start بزنه یه اکانت تستی می‌گیره؛ ۰ یعنی فقط با کد اتصال
BOT_SELF_SIGNUP=1
DEFAULT_QUOTA_GB=5
DEFAULT_DAYS=30
# مسیر دیتابیس؛ روی Railway یه Volume روی /data بذار و اینو بذار /data/data.db
DB_PATH=data.db
# اختیاری؛ اگه خالی باشه از دامنه‌ی Railway استفاده می‌شه
PUBLIC_URL=
